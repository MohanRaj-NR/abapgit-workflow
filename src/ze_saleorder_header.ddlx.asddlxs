@Metadata.layer: #CORE

@UI: { 
  headerInfo: { 
    typeName: 'Sales Order', 
    typeNamePlural: 'Sales Orders',                         
    title: { type: #STANDARD, value: 'Vbeln' } 
  }
}
                     
annotate entity zc_saleorder_header with
{

  @UI.facet: [
    /* 1. Header Facet (Appears at the very top of the Object Page) */
    {
      id: 'HeaderFacet', 
      purpose: #HEADER,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'HeaderValues'
    },
               
    /* 2. Main Body Collection (The first Tab/Section) */
    {
      id: 'GeneralInfo',
      type: #COLLECTION,
      label: 'General Information',
      position: 10
    },
               
    /* 2a. Fieldgroup inside the Collection */
    { 
      id: 'OrderValues',
      type: #FIELDGROUP_REFERENCE,
      parentId: 'GeneralInfo',
      label: 'Order Details',
      position: 10,
      targetQualifier: 'OrderValues'
    },
               
    /* 2b. Fieldgroup inside the Collection */
    { 
      id: 'OrderAudit',
      type: #FIELDGROUP_REFERENCE,
      parentId: 'GeneralInfo',
      label: 'Admin Data',
      position: 20,
      targetQualifier: 'OrderAudit' 
    },
    
    /* 3. Child Items Table (The second Tab/Section) */
    {
      id: 'OrderItems',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Order Items',
      position: 20,
      targetElement: '_ITEM' 
    }
  ]

  /* --- FIELDS --- */
  
  @UI: { 
    lineItem:       [{ position: 10, label: 'Sales Order', importance: #HIGH }], 
    identification: [{ position: 10, label: 'Sales Order' }],  
    fieldGroup:     [{ qualifier: 'HeaderValues', position: 10 }]   
  }
  Vbeln;
  
  @UI: { 
    lineItem:       [{ position: 20, label: 'Total Order Value', importance: #HIGH }], 
    identification: [{ position: 20, label: 'Total Order Value' }], 
    fieldGroup:     [{ qualifier: 'OrderValues', position: 10 }]   
  }   
  Netwr;
  
  /* --- AUDIT FIELDS --- */
  
  @UI: { 
    lineItem:       [{ position: 30, label: 'Created By', importance: #HIGH }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 10 }]   
  }       
  Localcreatedby;
  
  @UI: { 
    lineItem:       [{ position: 40, label: 'Created At', importance: #HIGH }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 20 }]   
  }  
  Localcreatedat;
  
  @UI: { 
    lineItem:       [{ position: 50, label: 'Changed By' }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 30 }]   
  } 
  Locallastchangedby;
  
  @UI: { 
    lineItem:       [{ position: 60, label: 'Changed At' }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 40 }]   
  }    
  Locallastchangedat;

}