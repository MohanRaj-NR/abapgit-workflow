@Metadata.layer: #CORE

@UI: { 
  headerInfo: { 
    typeName: 'Sales Order', 
    typeNamePlural: 'Sales Orders',                         
    title: { type: #STANDARD, value: 'Vbeln' } 
  }
}
                     
annotate entity zc_saleorder_header with
{

  /* ==========================================================
     1. FACETS (Screen Layout Configuration)
     ========================================================== */
  @UI.facet: [
    /* Top Header Area */
    {
      id: 'HeaderFacet', 
      purpose: #HEADER,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'HeaderValues'
    },
               
    /* Tab 1: General Information */
    {
      id: 'GeneralInfo',
      type: #COLLECTION,
      label: 'General Information',
      position: 10
    },
               
    /* Tab 1, Section A: Order Details */
    { 
      id: 'OrderValues',
      type: #FIELDGROUP_REFERENCE,
      parentId: 'GeneralInfo',
      label: 'Order Details',
      position: 10,
      targetQualifier: 'OrderValues'
    },
               
    /* Tab 1, Section B: Admin Data */
    { 
      id: 'OrderAudit',
      type: #FIELDGROUP_REFERENCE,
      parentId: 'GeneralInfo',
      label: 'Admin Data',
      position: 20,
      targetQualifier: 'OrderAudit' 
    },
    
    /* Tab 2: Child Items Table */
    {
      id: 'OrderItems',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Order Items',
      position: 20,
      targetElement: '_ITEM' 
    }
  ]

  /* ==========================================================
     2. FIELDS & BUTTONS (UI Binding)
     ========================================================== */
  
  @UI: { 
    /* --- LIST REPORT (MAIN TABLE) --- */
    lineItem: [
      { position: 10, label: 'Sales Order', importance: #HIGH },
      
      /* Instance Actions & Functions */
      { type: #FOR_ACTION,   dataAction: 'copyOrder',          label: 'Copy Order',   position: 10 },
      { type: #FOR_ACTION,   dataAction: 'blockOrder',         label: 'Block Orders', position: 20, invocationGrouping: #CHANGE_SET },
      { type: #FOR_ACTION,   dataAction: 'SurgeCharge',         label: 'Surge Charge',  position: 30 },
      { type: #FOR_ACTION,   dataAction: 'cleanupOldDrafts',   label: 'Cleanup Old Drafts', position: 40 }
      
    ], 
    
    /* --- OBJECT PAGE (INSIDE THE ORDER) --- */
    identification: [
      { position: 10, label: 'Sales Order' },
      
      /* Notice: Static actions are NOT here, because you are inside a specific order! */
      { type: #FOR_ACTION,   dataAction: 'copyOrder',          label: 'Copy Order',   position: 10 },
      { type: #FOR_ACTION,   dataAction: 'blockOrder',         label: 'Block Order',  position: 20 }
    
      
    ],  
    
    /* --- HEADER FACET --- */
    fieldGroup: [{ qualifier: 'HeaderValues', position: 10 }]   
  }
  Vbeln;
  
  
  @UI: { 
    lineItem:       [{ position: 20, label: 'Total Order Value', importance: #HIGH }], 
    identification: [{ position: 20, label: 'Total Order Value' }], 
    fieldGroup:     [{ qualifier: 'OrderValues', position: 10 }]   
  }   
  Netwr;
  
  
  /* ==========================================================
     3. AUDIT FIELDS (Admin Tab)
     ========================================================== */
  
  @UI: { 
    lineItem:       [{ position: 30, label: 'Created By', importance: #HIGH }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 10 }]   
  }       
  localcreatedby;
  
  @UI: { 
    lineItem:       [{ position: 40, label: 'Created At', importance: #HIGH }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 20 }]   
  }  
  localcreatedat;
  
  @UI: { 
    lineItem:       [{ position: 50, label: 'Changed By' }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 30 }]   
  } 
  locallastchangedby;
  
  @UI: { 
    lineItem:       [{ position: 60, label: 'Changed At' }], 
    fieldGroup:     [{ qualifier: 'OrderAudit', position: 40 }]   
  }    
  locallastchangedat;

}